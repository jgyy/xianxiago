# Godot 4+ specific ignores
# .godot/ holds the per-machine import cache (imported .scn/.ctex etc.).
# Source assets (.glb, .png, .obj, ...) and their .import sidecars ARE tracked;
# run `godot --headless --path . --import` to regenerate the cache.
.godot/
.import/
export.cfg
export_presets.cfg
*.translation
.mono/
data_*/

# Blender autosave/backups (the .blend source files themselves are tracked)
*.blend1
*.blend2
*.blend3
*.blend@

# OS / editor clutter
.DS_Store
Thumbs.db

# Python bytecode from the Blender generators
__pycache__/
*.pyc

# Claude Code local worktrees
.claude/
